# fcc fraction of GPUMD frames with the same CNA as md/e2_melting (cna/atom, cutoff 0.854 a0).
#   lmp -in in.cna_rerun -var d coexist_900
variable a0 equal 3.9899
units      metal
atom_style atomic
boundary   p p p
read_data  ${d}/frame0.data
pair_style zero 6.0
pair_coeff * *
compute    c all cna/atom $(0.854*v_a0)
variable   isfcc atom c_c==1
compute    nf all reduce sum v_isfcc
variable   ffcc equal c_nf/atoms
thermo_style custom step v_ffcc
thermo_modify format float %.5f
thermo     1
rerun      ${d}/prod.dump dump x y z box yes
