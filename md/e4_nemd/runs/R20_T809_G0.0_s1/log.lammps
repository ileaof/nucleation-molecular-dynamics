unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 809-${G}*${Q}
variable     Tc equal 809-0.0*${Q}
variable     Tc equal 809-0.0*100.507315686739
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 809+${G}*${Q}
variable     Th equal 809+0.0*${Q}
variable     Th equal 809+0.0*100.507315686739
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 809.00 K at z = 92.3, hot 809.00 K at z = 293.3; G = 0.0 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.260684313260000522 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.260684313260000522 97.260684313260000522 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.27531568673799711 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.27531568673799711 298.27531568673799711 units box
group        gcold region cold
9729 atoms in group gcold
group        ghot  region hot
9766 atoms in group ghot
velocity     sol create ${T0} $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 809 $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 809 3001 mom yes rot yes dist gaussian
unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lc gcold langevin 809 ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lc gcold langevin 809 809 0.1 $(5000+v_seed) zero yes tally yes
