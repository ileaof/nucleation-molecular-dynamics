unfix        eq
variable     aT equal (lx/${n})
variable     aT equal (lx/32)
print        "lattice at T0: a = $(v_aT:%.4f) A"
lattice at T0: a = 4.1093 A
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff $(0.854*v_aT)
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff 3.5093233301445443395
compute      nb all coord/atom orientorder q6 ${qdot}
compute      nb all coord/atom orientorder q6 0.5
variable     issol atom c_nb>=${nbond}
variable     issol atom c_nb>=7
compute      nsol all reduce sum v_issol
variable     Nsol equal c_nsol

# 2) melt outside the sphere and quench the liquid to T0, both at P = 0, seed frozen (as in ../e4_seeding/in.seed)
variable     xc equal (xlo+xhi)/2
variable     yc equal (ylo+yhi)/2
variable     zc equal (zlo+zhi)/2
region       ball sphere ${xc} ${yc} ${zc} ${R} units box
region       ball sphere 64.2559999999998 ${yc} ${zc} ${R} units box
region       ball sphere 64.2559999999998 64.2559999999998 ${zc} ${R} units box
region       ball sphere 64.2559999999998 64.2559999999998 192.767999999999 ${R} units box
region       ball sphere 64.2559999999998 64.2559999999998 192.767999999999 20 units box
group        sol region ball
1942 atoms in group sol
group        liq subtract all sol
391274 atoms in group liq
compute      tliq liq temp
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
velocity     liq create ${Tmelt} $(2000+v_seed) mom yes rot yes dist gaussian
