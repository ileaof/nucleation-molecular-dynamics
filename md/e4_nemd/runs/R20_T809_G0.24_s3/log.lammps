unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 809-${G}*${Q}
variable     Tc equal 809-0.24*${Q}
variable     Tc equal 809-0.24*100.513952686946
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 809+${G}*${Q}
variable     Th equal 809+0.24*${Q}
variable     Th equal 809+0.24*100.513952686946
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 784.88 K at z = 92.3, hot 833.12 K at z = 293.3; G = 0.24 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.254047313054002188 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.254047313054002188 97.254047313054002188 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.28195268694599918 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.28195268694599918 298.28195268694599918 units box
group        gcold region cold
