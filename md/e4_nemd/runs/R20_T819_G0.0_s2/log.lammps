unfix        cool

# 3) impose the linear profile on the liquid with a local Langevin thermostat (target T(z) per atom), box now fixed.
#    u = z − L/2; between the slabs (|u| <= L/4) T = T0 + G·u; on the return path T = T0 + G·(sign(u)·L/2 − u).
variable     Lz equal lz
variable     zm equal ${zc}
variable     zm equal 192.768
variable     Q  equal ${Lz}/4
variable     Q  equal 402.235959511769/4
variable     u  atom z-${zm}
variable     u  atom z-192.768
variable     Ttg atom (abs(v_u)<=${Q})*(${T0}+${G}*v_u)+(abs(v_u)>${Q})*(${T0}+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(${T0}+${G}*v_u)+(abs(v_u)>${Q})*(${T0}+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+${G}*v_u)+(abs(v_u)>${Q})*(${T0}+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+0.0*v_u)+(abs(v_u)>${Q})*(${T0}+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+0.0*v_u)+(abs(v_u)>100.558989877942)*(${T0}+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+0.0*v_u)+(abs(v_u)>100.558989877942)*(819+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+0.0*v_u)+(abs(v_u)>100.558989877942)*(819+0.0*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+0.0*v_u)+(abs(v_u)>100.558989877942)*(819+0.0*((v_u>=0)*2*100.558989877942-(v_u<0)*2*${Q}-v_u))
variable     Ttg atom (abs(v_u)<=100.558989877942)*(819+0.0*v_u)+(abs(v_u)>100.558989877942)*(819+0.0*((v_u>=0)*2*100.558989877942-(v_u<0)*2*100.558989877942-v_u))
fix          nvel liq nve
fix          prof liq langevin v_Ttg ${T0} 0.1 $(4000+v_seed) zero yes
fix          prof liq langevin v_Ttg 819 0.1 $(4000+v_seed) zero yes
fix          prof liq langevin v_Ttg 819 0.1 4002 zero yes
run          ${nprof}
run          5000
