unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 819-${G}*${Q}
variable     Tc equal 819-0.0*${Q}
variable     Tc equal 819-0.0*100.558989877942
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 819+${G}*${Q}
variable     Th equal 819+0.0*${Q}
variable     Th equal 819+0.0*100.558989877942
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 819.00 K at z = 92.2, hot 819.00 K at z = 293.3; G = 0.0 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.209010122058003844 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.209010122058003844 97.209010122058003844 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.3269898779419691 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.3269898779419691 298.3269898779419691 units box
group        gcold region cold
9775 atoms in group gcold
group        ghot  region hot
9734 atoms in group ghot
velocity     sol create ${T0} $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 819 $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 819 3002 mom yes rot yes dist gaussian
unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lc gcold langevin 819 ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
