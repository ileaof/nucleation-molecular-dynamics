unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 799-${G}*${Q}
variable     Tc equal 799-0.0*${Q}
variable     Tc equal 799-0.0*100.466380770412
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 799+${G}*${Q}
variable     Th equal 799+0.0*${Q}
variable     Th equal 799+0.0*100.466380770412
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 799.00 K at z = 92.3, hot 799.00 K at z = 293.2; G = 0.0 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.301619229587998916 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.301619229587998916 97.301619229587998916 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.23438077041203087 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.23438077041203087 298.23438077041203087 units box
group        gcold region cold
9768 atoms in group gcold
group        ghot  region hot
9751 atoms in group ghot
velocity     sol create ${T0} $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 799 $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 799 3001 mom yes rot yes dist gaussian
unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lc gcold langevin 799 ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
