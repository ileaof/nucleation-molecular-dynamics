unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 829-${G}*${Q}
variable     Tc equal 829-0.48*${Q}
variable     Tc equal 829-0.48*100.593821960174
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 829+${G}*${Q}
variable     Th equal 829+0.48*${Q}
variable     Th equal 829+0.48*100.593821960174
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 780.71 K at z = 92.2, hot 877.29 K at z = 293.4; G = 0.48 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.174178039824013808 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.174178039824013808 97.174178039824013808 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.36182196017199431 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.36182196017199431 298.36182196017199431 units box
group        gcold region cold
9804 atoms in group gcold
group        ghot  region hot
9697 atoms in group ghot
velocity     sol create ${T0} $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 829 $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 829 3001 mom yes rot yes dist gaussian
unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
