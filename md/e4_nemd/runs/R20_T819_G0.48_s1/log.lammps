# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 819-${G}*${Q}
variable     Tc equal 819-0.48*${Q}
variable     Tc equal 819-0.48*100.553938735996
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 819+${G}*${Q}
variable     Th equal 819+0.48*${Q}
variable     Th equal 819+0.48*100.553938735996
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 770.73 K at z = 92.2, hot 867.27 K at z = 293.3; G = 0.48 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.214061264005991347 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.214061264005991347 97.214061264005991347 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.32193873599800327 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.32193873599800327 298.32193873599800327 units box
group        gcold region cold
