unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 809-${G}*${Q}
variable     Tc equal 809-0.48*${Q}
variable     Tc equal 809-0.48*100.510480422281
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 809+${G}*${Q}
variable     Th equal 809+0.48*${Q}
variable     Th equal 809+0.48*100.510480422281
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 760.75 K at z = 92.3, hot 857.25 K at z = 293.3; G = 0.48 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.257519577715981995 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.257519577715981995 97.257519577715981995 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.27848042227799397 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.27848042227799397 298.27848042227799397 units box
group        gcold region cold
