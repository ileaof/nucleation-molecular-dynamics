unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lc gcold langevin 760.754969397305 ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
