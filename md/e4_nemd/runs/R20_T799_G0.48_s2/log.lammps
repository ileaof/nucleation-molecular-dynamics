LAMMPS (10 Sep 2025)
  using 1 OpenMP thread(s) per MPI task
package gpu 1
# E4 — seed under an imposed thermal gradient (NEMD). Box elongated along z; cold slab at z = L/4, hot slab at
# z = 3L/4 (Langevin, only these slabs); everything else NVE, so the latent heat of the seed is conducted, not removed.
# Seed (fcc sphere, radius R) at z = L/2, where the imposed profile gives T0. Between the slabs T(z) = T0 + G·(z − L/2).
# The gradient that enters Γ = A·∇T is the LOCAL one at the seed interface (author, 2026-10-05), measured afterwards
# from the 3D temperature field written here; the seed shape is followed from the solid atoms.
#   lmp -sf gpu -pk gpu 1 -in in.nemd -var T0 809 -var R 20 -var G 0.24 -var seed 1 -var out <dir>
# Units: Å, ps, eV, K; G in K/Å (1 K/Å = 1e10 K/m).
variable pot   index borovikov
variable T0    index 809
variable R     index 20
variable G     index 0.0
variable n     index 32          # x, y cells
variable nz    index 96          # z cells
variable seed  index 1
variable out   index .
variable w     index 10.0        # thermostat slab width [Å]
variable neq   index 5000        # 10 ps
variable ncool index 2500        # 5 ps
variable nprof index 5000        # 10 ps building the linear profile (seed frozen)
variable nprod index 50000       # 100 ps production
variable Tmelt index 1500
variable qdot  index 0.5
variable nbond index 7
variable a0 equal 4.016

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
lattice      fcc 4.016
Lattice spacing in x,y,z = 4.016 4.016 4.016
region       box block 0 ${n} 0 ${n} 0 ${nz}
region       box block 0 32 0 ${n} 0 ${nz}
region       box block 0 32 0 32 0 ${nz}
region       box block 0 32 0 32 0 96
create_box   1 box
Created orthogonal box = (0 0 0) to (128.512 128.512 385.536)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 393216 atoms
  using lattice units in orthogonal box = (0 0 0) to (128.512 128.512 385.536)
  create_atoms CPU = 0.019 seconds
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
include      ../e2_melting/pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
thermo       500

# 1) solid at T0, P = 0
velocity     all create ${T0} $(1000+v_seed) mom yes rot yes dist gaussian
velocity     all create 799 $(1000+v_seed) mom yes rot yes dist gaussian
velocity     all create 799 1002 mom yes rot yes dist gaussian
fix          eq all npt temp ${T0} ${T0} 0.2 iso 0.0 0.0 2.0
fix          eq all npt temp 799 ${T0} 0.2 iso 0.0 0.0 2.0
fix          eq all npt temp 799 799 0.2 iso 0.0 0.0 2.0
run          ${neq}
run          5000

