group        ghot  region hot
9726 atoms in group ghot
velocity     sol create ${T0} $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 849 $(3000+v_seed) mom yes rot yes dist gaussian
velocity     sol create 849 3001 mom yes rot yes dist gaussian
unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lc gcold langevin 824.834926091693 ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
