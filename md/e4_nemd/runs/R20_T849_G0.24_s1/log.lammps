unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Tc equal 849-${G}*${Q}
variable     Tc equal 849-0.24*${Q}
variable     Tc equal 849-0.24*100.68780795128
variable     Th equal ${T0}+${G}*${Q}
variable     Th equal 849+${G}*${Q}
variable     Th equal 849+0.24*${Q}
variable     Th equal 849+0.24*100.68780795128
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
slabs: cold 824.83 K at z = 92.1, hot 873.17 K at z = 293.5; G = 0.24 K/A
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.080192048719993636 $(v_zm-v_Q+v_w/2) units box
region       cold block INF INF INF INF 87.080192048719993636 97.080192048719993636 units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.45580795128000773 $(v_zm+v_Q+v_w/2) units box
region       hot  block INF INF INF INF 288.45580795128000773 298.45580795128000773 units box
group        gcold region cold
