# E4 — seed under an imposed thermal gradient (NEMD). Box elongated along z; cold slab at z = L/4, hot slab at
# z = 3L/4 (Langevin, only these slabs); everything else NVE, so the latent heat of the seed is conducted, not removed.
# Seed (fcc sphere, radius R) at z = L/2, where the imposed profile gives T0. Between the slabs T(z) = T0 + G·(z − L/2).
# The gradient that enters Γ = A·∇T is the LOCAL one at the seed interface (author, 2026-10-05), measured afterwards
# from the 3D temperature field written here; the seed shape is followed from the solid atoms.
#   lmp -sf gpu -pk gpu 1 -in in.nemd -var T0 809 -var R 20 -var G 0.24 -var seed 1 -var out <dir>
# Units: Å, ps, eV, K; G in K/Å (1 K/Å = 1e10 K/m).
variable pot   index borovikov
variable T0    index 809
variable R     index 20
variable G     index 0.0
variable n     index 32          # x, y cells
variable nz    index 96          # z cells
variable seed  index 1
variable out   index .
variable w     index 10.0        # thermostat slab width [Å]
variable neq   index 5000        # 10 ps
variable ncool index 2500        # 5 ps
variable nprof index 5000        # 10 ps building the linear profile (seed frozen)
variable nprod index 50000       # 100 ps production
variable Tmelt index 1500
variable qdot  index 0.5
variable nbond index 7
variable a0 equal 4.016

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
region       box block 0 ${n} 0 ${n} 0 ${nz}
create_box   1 box
create_atoms 1 box
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
timestep     0.002
thermo       500

# 1) solid at T0, P = 0
velocity     all create ${T0} $(1000+v_seed) mom yes rot yes dist gaussian
fix          eq all npt temp ${T0} ${T0} 0.2 iso 0.0 0.0 2.0
run          ${neq}
unfix        eq
variable     aT equal (lx/${n})
print        "lattice at T0: a = $(v_aT:%.4f) A"
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff $(0.854*v_aT)
compute      nb all coord/atom orientorder q6 ${qdot}
variable     issol atom c_nb>=${nbond}
compute      nsol all reduce sum v_issol
variable     Nsol equal c_nsol

# 2) melt outside the sphere and quench the liquid to T0, both at P = 0, seed frozen (as in ../e4_seeding/in.seed)
variable     xc equal (xlo+xhi)/2
variable     yc equal (ylo+yhi)/2
variable     zc equal (zlo+zhi)/2
region       ball sphere ${xc} ${yc} ${zc} ${R} units box
group        sol region ball
group        liq subtract all sol
compute      tliq liq temp
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
velocity     liq create ${Tmelt} $(2000+v_seed) mom yes rot yes dist gaussian
fix          melt liq npt temp ${Tmelt} ${Tmelt} 0.2 iso 0.0 0.0 2.0 dilate liq
fix_modify   melt temp tliq
run          ${neq}
unfix        melt
fix          cool liq npt temp ${T0} ${T0} 0.2 iso 0.0 0.0 2.0 dilate liq
fix_modify   cool temp tliq
run          ${ncool}
unfix        cool

# 3) impose the linear profile on the liquid with a local Langevin thermostat (target T(z) per atom), box now fixed.
#    u = z − L/2; between the slabs (|u| <= L/4) T = T0 + G·u; on the return path T = T0 + G·(sign(u)·L/2 − u).
variable     Lz equal lz
variable     zm equal ${zc}
variable     Q  equal ${Lz}/4
variable     u  atom z-${zm}
variable     Ttg atom (abs(v_u)<=${Q})*(${T0}+${G}*v_u)+(abs(v_u)>${Q})*(${T0}+${G}*((v_u>=0)*2*${Q}-(v_u<0)*2*${Q}-v_u))
fix          nvel liq nve
fix          prof liq langevin v_Ttg ${T0} 0.1 $(4000+v_seed) zero yes
run          ${nprof}
unfix        prof
unfix        freeze

# 4) production: seed free, NVE everywhere, Langevin only in the two slabs
variable     Tc equal ${T0}-${G}*${Q}
variable     Th equal ${T0}+${G}*${Q}
print        "slabs: cold $(v_Tc:%.2f) K at z = $(v_zm-v_Q:%.1f), hot $(v_Th:%.2f) K at z = $(v_zm+v_Q:%.1f); G = ${G} K/A"
region       cold block INF INF INF INF $(v_zm-v_Q-v_w/2) $(v_zm-v_Q+v_w/2) units box
region       hot  block INF INF INF INF $(v_zm+v_Q-v_w/2) $(v_zm+v_Q+v_w/2) units box
group        gcold region cold
group        ghot  region hot
velocity     sol create ${T0} $(3000+v_seed) mom yes rot yes dist gaussian
unfix        nvel
fix          nveall all nve
fix          lc gcold langevin ${Tc} ${Tc} 0.1 $(5000+v_seed) zero yes tally yes
fix          lh ghot  langevin ${Th} ${Th} 0.1 $(6000+v_seed) zero yes tally yes
# T(z) profile (1D, 5 Å) and 3D field (6 Å) averaged over 10 ps windows
compute      cz all chunk/atom bin/1d z lower 5.0 units box
fix          tz all ave/chunk 10 500 5000 cz temp density/number file ${out}/Tz.txt
compute      c3 all chunk/atom bin/3d x lower 6.0 y lower 6.0 z lower 6.0 units box
fix          t3 all ave/chunk 10 500 5000 c3 temp density/number file ${out}/T3d.txt
# solid atoms every 2 ps (shape, centre, extent)
dump         ds all custom 1000 ${out}/solid.dump id x y z c_nb
dump_modify  ds thresh c_nb >= ${nbond} sort id
thermo_style custom step temp pe etotal press v_Nsol f_lc f_lh
run          ${nprod}
