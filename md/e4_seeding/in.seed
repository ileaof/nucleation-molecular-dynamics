# E4 — seeding at zero thermal-field gradient: a spherical fcc seed of radius R in undercooled liquid Al at T.
# The seed grows if R > r_c(T) and melts if R < r_c(T); bracketing T for each R gives ΔT(r_c) and the
# Gibbs–Thomson reference Γ = ΔT·r_c/2 at ∇T = 0 (baseline for the NEMD runs with an imposed gradient).
#   lmp -sf gpu -pk gpu 1 -in in.seed -var pot borovikov -var T 820 -var R 20 -var seed 1
# Lengths Å, time ps, energy eV. Solid atoms: ten Wolde q6 bonds (see below).
variable pot   index borovikov
variable T     index 820
variable R     index 20          # seed radius [Å]
variable n     index 32          # box = n fcc cells per side
variable seed  index 1
variable neq   index 5000        # 10 ps per preparation stage
variable nprod index 30000       # 60 ps production
variable ncool index 2500        # 5 ps quench of the liquid to T (short: the seed can already grow here)
variable Tmelt index 1500
variable qdot  index 0.5
variable nbond index 7
variable a0 equal 4.05
if "${pot} == borovikov" then "variable a0 equal 4.016"
if "${pot} == mendelev" then "variable a0 equal 4.045"

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
region       box block 0 ${n} 0 ${n} 0 ${n}
create_box   1 box
create_atoms 1 box
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
timestep     0.002
thermo       500

# 1) solid at T, zero stress: box at the solid density of T (the seed keeps this lattice)
velocity     all create ${T} $(1000+v_seed) mom yes rot yes dist gaussian
fix          eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0
run          ${neq}
unfix        eq
# Solid atoms by the ten Wolde criterion: q6 vectors over the 12 nearest neighbours; a bond i-j is solid-like
# if q6(i)·q6(j) > qdot; an atom is solid if it has >= nbond such bonds. Cutoff 0.854·a(T) (between the 1st
# and 2nd shells of the solid at T). CNA was tried and rejected: at 820 K it labels only 56 % of a perfect crystal.
variable     aT equal (vol/(${n}^3))^(1/3)
print        "lattice at T: a = $(v_aT:%.4f) A, neighbour cutoff = $(0.854*v_aT:%.4f) A"
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff $(0.854*v_aT)
compute      nb all coord/atom orientorder q6 ${qdot}
variable     issol atom c_nb>=${nbond}
compute      nsol all reduce sum v_issol
variable     Nsol equal c_nsol
thermo_style custom step temp press pe vol v_Nsol
run          0

# 2) melt everything outside the sphere with the seed frozen, then bring the liquid to T. Both stages at P = 0:
#    only the liquid is integrated and dilated, and thermostat/barostat use the liquid temperature
#    (fix npt on 'all' would thermostat the frozen seed too — HANDOFF §7; at fixed volume the liquid sits at
#    the solid density, ~4 GPa, and crystallises on cooling).
variable     xc equal (xlo+xhi)/2
variable     yc equal (ylo+yhi)/2
variable     zc equal (zlo+zhi)/2
region       ball sphere ${xc} ${yc} ${zc} ${R} units box
group        sol region ball
group        liq subtract all sol
compute      tliq liq temp
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
velocity     liq create ${Tmelt} $(2000+v_seed) mom yes rot yes dist gaussian
fix          melt liq npt temp ${Tmelt} ${Tmelt} 0.2 iso 0.0 0.0 2.0 dilate liq
fix_modify   melt temp tliq
run          ${neq}
unfix        melt
fix          cool liq npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0 dilate liq
fix_modify   cool temp tliq
run          ${ncool}
unfix        cool
unfix        freeze

# 3) production: everything free, NPT iso at T
velocity     sol create ${T} $(3000+v_seed) mom yes rot yes dist gaussian
fix          prod all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0
run          ${nprod}
