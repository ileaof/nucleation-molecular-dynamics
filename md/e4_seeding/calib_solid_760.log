variable     rc equal 3.5027362650246001152
if "${phase} == liquid" then "unfix eq" "fix m all nvt temp 1500 1500 0.2" "run 5000" "unfix m" "fix eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0" "run 5000"
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff ${rc}
