LAMMPS (10 Sep 2025)
  using 1 OpenMP thread(s) per MPI task
package gpu 1
# Calibration of the ten Wolde solid criterion: fraction labelled solid in bulk solid and in bulk liquid at T,
# for several (qdot, nbond). Same neighbour definition as in.seed (12 nearest, cutoff 0.854·a(T)).
#   lmp -sf gpu -pk gpu 1 -in in.calib -var T 820 -var phase solid|liquid
variable pot   index borovikov
variable T     index 820
variable phase index solid
variable n     index 10
variable seed  index 5
variable a0 equal 4.016
units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
lattice      fcc 4.016
Lattice spacing in x,y,z = 4.016 4.016 4.016
region       box block 0 ${n} 0 ${n} 0 ${n}
region       box block 0 10 0 ${n} 0 ${n}
region       box block 0 10 0 10 0 ${n}
region       box block 0 10 0 10 0 10
create_box   1 box
Created orthogonal box = (0 0 0) to (40.16 40.16 40.16)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 4000 atoms
  using lattice units in orthogonal box = (0 0 0) to (40.16 40.16 40.16)
  create_atoms CPU = 0.003 seconds
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
include      ../e2_melting/pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
thermo       1000
velocity     all create ${T} ${seed} mom yes rot yes dist gaussian
velocity     all create 760 ${seed} mom yes rot yes dist gaussian
velocity     all create 760 5 mom yes rot yes dist gaussian
fix          eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0
fix          eq all npt temp 760 ${T} 0.2 iso 0.0 0.0 2.0
fix          eq all npt temp 760 760 0.2 iso 0.0 0.0 2.0
run          5000

