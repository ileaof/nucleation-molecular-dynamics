# Calibration of the ten Wolde solid criterion: fraction labelled solid in bulk solid and in bulk liquid at T,
# for several (qdot, nbond). Same neighbour definition as in.seed (12 nearest, cutoff 0.854·a(T)).
#   lmp -sf gpu -pk gpu 1 -in in.calib -var T 820 -var phase solid|liquid
variable pot   index borovikov
variable T     index 820
variable phase index solid
variable n     index 10
variable seed  index 5
variable a0 equal 4.016
units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
region       box block 0 ${n} 0 ${n} 0 ${n}
create_box   1 box
create_atoms 1 box
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
timestep     0.002
thermo       1000
velocity     all create ${T} ${seed} mom yes rot yes dist gaussian
fix          eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0
run          5000
variable     aT equal (vol/(${n}^3))^(1/3)
variable     rc equal $(0.854*v_aT)
if "${phase} == liquid" then "unfix eq" "fix m all npt temp 1500 1500 0.2 iso 0.0 0.0 2.0" "run 5000" "unfix m" "fix eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0" "run 5000"
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff ${rc}
compute      b5 all coord/atom orientorder q6 0.5
compute      b6 all coord/atom orientorder q6 0.6
compute      b7 all coord/atom orientorder q6 0.7
variable     s5_6 atom c_b5>=6
variable     s5_7 atom c_b5>=7
variable     s5_8 atom c_b5>=8
variable     s6_6 atom c_b6>=6
variable     s6_7 atom c_b6>=7
variable     s6_8 atom c_b6>=8
variable     s7_6 atom c_b7>=6
variable     s7_7 atom c_b7>=7
compute      f all reduce ave v_s5_6 v_s5_7 v_s5_8 v_s6_6 v_s6_7 v_s6_8 v_s7_6 v_s7_7
fix          avg all ave/time 500 20 10000 c_f[*] file calib_${phase}_${T}.txt
thermo_style custom step temp press pe c_f[1] c_f[2] c_f[3] c_f[5] c_f[6]
run          10000
