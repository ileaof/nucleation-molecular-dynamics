variable     aT equal (vol/(${n}^3))^(1/3)
variable     aT equal (vol/(10^3))^(1/3)
variable     rc equal $(0.854*v_aT)
variable     rc equal 3.5200751597027233331
if "${phase} == liquid" then "unfix eq" "fix m all nvt temp 1500 1500 0.2" "run 5000" "unfix m" "fix eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0" "run 5000"
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff ${rc}
compute      q6 all orientorder/atom degrees 1 6 components 6 nnn 12 cutoff 3.52007515970272
compute      b5 all coord/atom orientorder q6 0.5
compute      b6 all coord/atom orientorder q6 0.6
compute      b7 all coord/atom orientorder q6 0.7
