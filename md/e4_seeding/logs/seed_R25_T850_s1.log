# 2) melt everything outside the sphere with the seed frozen, then bring the liquid to T. Both stages at P = 0:
#    only the liquid is integrated and dilated, and thermostat/barostat use the liquid temperature
#    (fix npt on 'all' would thermostat the frozen seed too — HANDOFF §7; at fixed volume the liquid sits at
#    the solid density, ~4 GPa, and crystallises on cooling).
variable     xc equal (xlo+xhi)/2
variable     yc equal (ylo+yhi)/2
variable     zc equal (zlo+zhi)/2
region       ball sphere ${xc} ${yc} ${zc} ${R} units box
region       ball sphere 64.256000000001 ${yc} ${zc} ${R} units box
region       ball sphere 64.256000000001 64.256000000001 ${zc} ${R} units box
region       ball sphere 64.256000000001 64.256000000001 64.256000000001 ${R} units box
region       ball sphere 64.256000000001 64.256000000001 64.256000000001 25 units box
group        sol region ball
3760 atoms in group sol
group        liq subtract all sol
127312 atoms in group liq
compute      tliq liq temp
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
velocity     liq create ${Tmelt} $(2000+v_seed) mom yes rot yes dist gaussian
velocity     liq create 1500 $(2000+v_seed) mom yes rot yes dist gaussian
velocity     liq create 1500 2001 mom yes rot yes dist gaussian
fix          melt liq npt temp ${Tmelt} ${Tmelt} 0.2 iso 0.0 0.0 2.0 dilate liq
fix          melt liq npt temp 1500 ${Tmelt} 0.2 iso 0.0 0.0 2.0 dilate liq
fix          melt liq npt temp 1500 1500 0.2 iso 0.0 0.0 2.0 dilate liq
fix_modify   melt temp tliq
