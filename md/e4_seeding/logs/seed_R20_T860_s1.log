package gpu 1
# E4 — seeding at zero thermal-field gradient: a spherical fcc seed of radius R in undercooled liquid Al at T.
# The seed grows if R > r_c(T) and melts if R < r_c(T); bracketing T for each R gives ΔT(r_c) and the
# Gibbs–Thomson reference Γ = ΔT·r_c/2 at ∇T = 0 (baseline for the NEMD runs with an imposed gradient).
#   lmp -sf gpu -pk gpu 1 -in in.seed -var pot borovikov -var T 820 -var R 20 -var seed 1
# Lengths Å, time ps, energy eV. Solid atoms: ten Wolde q6 bonds (see below).
variable pot   index borovikov
variable T     index 820
variable R     index 20          # seed radius [Å]
variable n     index 32          # box = n fcc cells per side
variable seed  index 1
variable neq   index 5000        # 10 ps per preparation stage
variable nprod index 30000       # 60 ps production
variable ncool index 2500        # 5 ps quench of the liquid to T (short: the seed can already grow here)
variable Tmelt index 1500
variable qdot  index 0.5
variable nbond index 7
variable a0 equal 4.05
if "${pot} == borovikov" then "variable a0 equal 4.016"
variable a0 equal 4.016
if "${pot} == mendelev" then "variable a0 equal 4.045"

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
lattice      fcc 4.016
Lattice spacing in x,y,z = 4.016 4.016 4.016
region       box block 0 ${n} 0 ${n} 0 ${n}
region       box block 0 32 0 ${n} 0 ${n}
region       box block 0 32 0 32 0 ${n}
region       box block 0 32 0 32 0 32
create_box   1 box
Created orthogonal box = (0 0 0) to (128.512 128.512 128.512)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 131072 atoms
  using lattice units in orthogonal box = (0 0 0) to (128.512 128.512 128.512)
  create_atoms CPU = 0.007 seconds
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
include      ../e2_melting/pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
thermo       500

# 1) solid at T, zero stress: box at the solid density of T (the seed keeps this lattice)
velocity     all create ${T} $(1000+v_seed) mom yes rot yes dist gaussian
velocity     all create 860 $(1000+v_seed) mom yes rot yes dist gaussian
velocity     all create 860 1001 mom yes rot yes dist gaussian
fix          eq all npt temp ${T} ${T} 0.2 iso 0.0 0.0 2.0
fix          eq all npt temp 860 ${T} 0.2 iso 0.0 0.0 2.0
fix          eq all npt temp 860 860 0.2 iso 0.0 0.0 2.0
run          ${neq}
run          5000

