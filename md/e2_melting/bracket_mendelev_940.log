# Solid-liquid coexistence (NPH, x-y fixed at the solid lattice, z free): T relaxes to T_m.
#   mpirun -np 16 lmp -in in.coexist -var pot alnb -var T0 930 -var seed 1
# Pure Al, fcc [001] interface normal to z. Lengths Å, time ps, energy eV.
variable pot   index alnb
variable T0    index 930
variable seed  index 4928459
variable nx    index 10
variable nz    index 30
variable nprod index 100000
variable neq   index 10000
variable Tmelt index 1700
variable ens   index nph
variable a0 equal 4.05
if "${pot} == alnb" then "variable a0 equal 4.0447"
if "${pot} == borovikov" then "variable a0 equal 4.016"
if "${pot} == mendelev" then "variable a0 equal 4.045"
variable a0 equal 4.045

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
lattice      fcc 4.045
Lattice spacing in x,y,z = 4.045 4.045 4.045
region       box block 0 ${nx} 0 ${nx} 0 ${nz}
region       box block 0 8 0 ${nx} 0 ${nz}
region       box block 0 8 0 8 0 ${nz}
region       box block 0 8 0 8 0 32
create_box   1 box
Created orthogonal box = (0 0 0) to (32.36 32.36 129.44)
  1 by 1 by 4 MPI processor grid
create_atoms 1 box
Created 8192 atoms
  using lattice units in orthogonal box = (0 0 0) to (32.36 32.36 129.44)
  create_atoms CPU = 0.001 seconds
mass         1 26.982
include      pot_${pot}.lmp
include      pot_mendelev.lmp
# Mendelev, Kramer, Becker, Asta, Philos. Mag. 88 (2008) 1723 — EAM/FS Al (LAMMPS distribution, Al_mm.eam.fs)
pair_style eam/fs
pair_coeff * * ../../potentials/Al_Mendelev2008/Al_mm.eam.fs Al
Reading eam/fs potential file ../../potentials/Al_Mendelev2008/Al_mm.eam.fs with DATE: 2007-06-11
timestep     0.002
thermo_style custom step temp press pzz pe enthalpy lx ly lz
thermo       1000

# 1) solid at T0, zero stress
velocity     all create ${T0} ${seed} mom yes rot yes dist gaussian
velocity     all create 940 ${seed} mom yes rot yes dist gaussian
velocity     all create 940 4928459 mom yes rot yes dist gaussian
fix          eq all npt temp ${T0} ${T0} 0.2 aniso 0.0 0.0 2.0
fix          eq all npt temp 940 ${T0} 0.2 aniso 0.0 0.0 2.0
fix          eq all npt temp 940 940 0.2 aniso 0.0 0.0 2.0
run          ${neq}
run          5000
