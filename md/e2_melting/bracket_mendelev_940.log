# 4) coexistence along z: ens = nph (T relaxes to T_m) or npt (interface moves unless T0 = T_m)
#    solid fraction by adaptive-free CNA (fcc), cutoff 0.854·a0
compute      cna all cna/atom $(0.854*v_a0)
compute      cna all cna/atom 3.4544299999999998896
variable     issol atom c_cna==1
compute      nsol all reduce sum v_issol
variable     fsol equal c_nsol/atoms
if "${ens} == npt" then "fix prod all npt temp ${T0} ${T0} 0.2 z 0.0 0.0 2.0" else "fix prod all nph z 0.0 0.0 2.0"
