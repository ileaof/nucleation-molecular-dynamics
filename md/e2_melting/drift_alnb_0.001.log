  using 1 OpenMP thread(s) per MPI task
# Energy conservation check (NVE) for a potential and timestep.
variable pot index alnb
variable dt  index 0.002
variable T   index 950
if "${pot} == alnb" then "variable a0 equal 4.0447" else "variable a0 equal 4.05"
variable a0 equal 4.0447
units metal
atom_style atomic
boundary p p p
lattice fcc ${a0}
lattice fcc 4.0447
Lattice spacing in x,y,z = 4.0447 4.0447 4.0447
region box block 0 8 0 8 0 8
create_box 1 box
Created orthogonal box = (0 0 0) to (32.3576 32.3576 32.3576)
  2 by 2 by 2 MPI processor grid
create_atoms 1 box
Created 2048 atoms
  using lattice units in orthogonal box = (0 0 0) to (32.3576 32.3576 32.3576)
  create_atoms CPU = 0.001 seconds
mass 1 26.982
include pot_${pot}.lmp
include pot_alnb.lmp
# Fereidonnejad, Moghaddam, Moaddeli, Comput. Mater. Sci. 213 (2022) 111685 — 2NN MEAM Al-Nb (NIST IPR)
pair_style meam
pair_coeff * * ../../potentials/AlNb_Fereidonnejad2022/library.meam Al Nb ../../potentials/AlNb_Fereidonnejad2022/AlNb.meam Al
timestep ${dt}
timestep 0.001
velocity all create $(2*v_T) 12345 mom yes rot yes dist gaussian
velocity all create 1900 12345 mom yes rot yes dist gaussian
fix 1 all nve
thermo_style custom step time temp etotal
thermo_modify format float %.6f
thermo $(round(1.0/v_dt))
thermo 1000
run $(round(20.0/v_dt))
run 20000
