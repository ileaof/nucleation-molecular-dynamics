unfix        melt
# 3) bring the liquid to T0, relax z only (solid still frozen)
fix          cool liq npt temp ${T0} ${T0} 0.2 z 0.0 0.0 2.0 dilate liq
fix          cool liq npt temp 930 ${T0} 0.2 z 0.0 0.0 2.0 dilate liq
fix          cool liq npt temp 930 930 0.2 z 0.0 0.0 2.0 dilate liq
run          ${neq}
run          500
