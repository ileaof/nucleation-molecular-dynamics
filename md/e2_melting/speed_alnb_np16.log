unfix        cool
unfix        freeze
velocity     sol create ${T0} $(v_seed+1) mom yes rot yes dist gaussian
velocity     sol create 930 $(v_seed+1) mom yes rot yes dist gaussian
velocity     sol create 930 4928460 mom yes rot yes dist gaussian

# 4) coexistence, NPH along z
compute      q6 all orientorder/atom degrees 1 6 nnn 12 cutoff 3.6
variable     issol atom c_q6[1]>0.40
compute      nsol all reduce sum v_issol
variable     fsol equal c_nsol/atoms
fix          nph all nph z 0.0 0.0 2.0
fix          avg all ave/time 100 10 1000 v_fsol
thermo_style custom step temp press pzz pe enthalpy lz v_fsol
dump         d all custom 25000 coexist_${pot}_${T0}.dump id x y z c_q6[1]
dump         d all custom 25000 coexist_alnb_${T0}.dump id x y z c_q6[1]
dump         d all custom 25000 coexist_alnb_930.dump id x y z c_q6[1]
run          ${nprod}
run          1000
