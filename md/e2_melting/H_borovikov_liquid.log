# Latent heat: <H>_liquid - <H>_solid at T (NPT, P = 0), pure Al.
#   mpirun -np 8 lmp -in in.enthalpy -var pot alnb -var T 930 -var phase solid|liquid
variable pot   index alnb
variable T     index 930
variable phase index solid
variable seed  index 7211
variable n     index 8
variable neq   index 10000
variable nprod index 25000
variable Tmelt index 1700
variable a0 equal 4.05
if "${pot} == alnb" then "variable a0 equal 4.0447"
if "${pot} == borovikov" then "variable a0 equal 4.016"
variable a0 equal 4.016
if "${pot} == mendelev" then "variable a0 equal 4.045"

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
lattice      fcc 4.016
Lattice spacing in x,y,z = 4.016 4.016 4.016
region       box block 0 ${n} 0 ${n} 0 ${n}
region       box block 0 8 0 ${n} 0 ${n}
region       box block 0 8 0 8 0 ${n}
region       box block 0 8 0 8 0 8
create_box   1 box
Created orthogonal box = (0 0 0) to (32.128 32.128 32.128)
  1 by 1 by 2 MPI processor grid
create_atoms 1 box
Created 2048 atoms
  using lattice units in orthogonal box = (0 0 0) to (32.128 32.128 32.128)
  create_atoms CPU = 0.059 seconds
mass         1 26.982
include      pot_${pot}.lmp
include      pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
thermo       1000
thermo_style custom step temp press pe enthalpy vol

if "${phase} == liquid" then    "velocity all create ${Tmelt} ${seed} mom yes rot yes dist gaussian"    "fix m all npt temp ${Tmelt} ${Tmelt} 0.2 iso 0.0 0.0 2.0"    "run ${neq}"    "unfix m" else    "velocity all create ${T} ${seed} mom yes rot yes dist gaussian"
velocity all create ${Tmelt} ${seed} mom yes rot yes dist gaussian
velocity all create 1700 ${seed} mom yes rot yes dist gaussian
velocity all create 1700 7211 mom yes rot yes dist gaussian
fix m all npt temp ${Tmelt} ${Tmelt} 0.2 iso 0.0 0.0 2.0
fix m all npt temp 1700 ${Tmelt} 0.2 iso 0.0 0.0 2.0
fix m all npt temp 1700 1700 0.2 iso 0.0 0.0 2.0
run ${neq}
run 10000
