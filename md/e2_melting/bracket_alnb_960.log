# Solid-liquid coexistence (NPH, x-y fixed at the solid lattice, z free): T relaxes to T_m.
#   mpirun -np 16 lmp -in in.coexist -var pot alnb -var T0 930 -var seed 1
# Pure Al, fcc [001] interface normal to z. Lengths Å, time ps, energy eV.
variable pot   index alnb
variable T0    index 930
variable seed  index 4928459
variable nx    index 10
variable nz    index 30
variable nprod index 100000
variable neq   index 10000
variable Tmelt index 1700
variable ens   index nph
if "${pot} == alnb" then "variable a0 equal 4.0447" else "variable a0 equal 4.05"
variable a0 equal 4.0447

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
lattice      fcc 4.0447
Lattice spacing in x,y,z = 4.0447 4.0447 4.0447
region       box block 0 ${nx} 0 ${nx} 0 ${nz}
region       box block 0 6 0 ${nx} 0 ${nz}
region       box block 0 6 0 6 0 ${nz}
region       box block 0 6 0 6 0 24
create_box   1 box
Created orthogonal box = (0 0 0) to (24.2682 24.2682 97.0728)
  1 by 1 by 4 MPI processor grid
create_atoms 1 box
Created 3456 atoms
  using lattice units in orthogonal box = (0 0 0) to (24.2682 24.2682 97.0728)
  create_atoms CPU = 0.001 seconds
mass         1 26.982
include      pot_${pot}.lmp
include      pot_alnb.lmp
# Fereidonnejad, Moghaddam, Moaddeli, Comput. Mater. Sci. 213 (2022) 111685 — 2NN MEAM Al-Nb (NIST IPR)
pair_style meam
pair_coeff * * ../../potentials/AlNb_Fereidonnejad2022/library.meam Al Nb ../../potentials/AlNb_Fereidonnejad2022/AlNb.meam Al
timestep     0.002
thermo_style custom step temp press pzz pe enthalpy lx ly lz
thermo       1000

# 1) solid at T0, zero stress
velocity     all create ${T0} ${seed} mom yes rot yes dist gaussian
velocity     all create 960 ${seed} mom yes rot yes dist gaussian
velocity     all create 960 4928459 mom yes rot yes dist gaussian
fix          eq all npt temp ${T0} ${T0} 0.2 aniso 0.0 0.0 2.0
fix          eq all npt temp 960 ${T0} 0.2 aniso 0.0 0.0 2.0
fix          eq all npt temp 960 960 0.2 aniso 0.0 0.0 2.0
run          ${neq}
run          5000
