# Capillary fluctuation method (Hoyt, Asta, Karma 2001): quasi-2D solid-liquid ribbon at T_m.
# Interface normal z, fluctuation direction x, thin y.  orient: 100 | 110 | 111 (interface plane)
#   mpirun -np 4 lmp -in in.cfm -var pot borovikov -var Tm 930 -var orient 100
variable pot    index borovikov
variable Tm     index 930
variable orient index 100
variable seed   index 3301
variable neq    index 25000
variable nprod  index 200000
variable nstage index 10000
variable ndump  index 2000
variable a0 equal 4.05
if "${pot} == borovikov" then "variable a0 equal 4.016"
variable a0 equal 4.016
if "${pot} == mendelev" then "variable a0 equal 4.045"
units        metal
atom_style   atomic
boundary     p p p
# (x, y, z) = (fluctuation, thin, interface normal)
if "${orient} == 100" then "lattice fcc ${a0} orient x 1 0 0 orient y 0 1 0 orient z 0 0 1" "region box block 0 60 0 3 0 30"
if "${orient} == 110" then "lattice fcc ${a0} orient x 0 0 1 orient y 1 -1 0 orient z 1 1 0" "region box block 0 60 0 2 0 21"
if "${orient} == 111" then "lattice fcc ${a0} orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1" "region box block 0 42 0 1 0 17"
lattice fcc ${a0} orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1
lattice fcc 4.016 orient x 1 -1 0 orient y 1 1 -2 orient z 1 1 1
Lattice spacing in x,y,z = 5.6794817 6.5581005 6.955916
region box block 0 42 0 1 0 17
create_box   1 box
Created orthogonal box = (0 0 0) to (238.53823 6.5581005 118.25057)
  4 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 11424 atoms
  using lattice units in orthogonal box = (0 0 0) to (238.53823 6.5581005 118.25057)
  create_atoms CPU = 0.010 seconds
mass         1 26.982
include      pot_${pot}.lmp
include      pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
thermo       1000
# solid at Tm, lateral lattice fixed afterwards
velocity     all create ${Tm} ${seed} mom yes rot yes dist gaussian
velocity     all create 936 ${seed} mom yes rot yes dist gaussian
velocity     all create 936 3301 mom yes rot yes dist gaussian
fix          eq all npt temp ${Tm} ${Tm} 0.2 aniso 0 0 2.0
fix          eq all npt temp 936 ${Tm} 0.2 aniso 0 0 2.0
fix          eq all npt temp 936 936 0.2 aniso 0 0 2.0
run          ${nstage}
run          10000
