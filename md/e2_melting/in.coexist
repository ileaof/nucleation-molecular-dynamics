# Solid-liquid coexistence (NPH, x-y fixed at the solid lattice, z free): T relaxes to T_m.
#   mpirun -np 16 lmp -in in.coexist -var pot alnb -var T0 930 -var seed 1
# Pure Al, fcc [001] interface normal to z. Lengths Å, time ps, energy eV.
variable pot   index alnb
variable T0    index 930
variable seed  index 4928459
variable nx    index 10
variable nz    index 30
variable nprod index 100000
variable neq   index 10000
variable Tmelt index 1700
variable ens   index nph
variable a0 equal 4.05
if "${pot} == alnb" then "variable a0 equal 4.0447"
if "${pot} == borovikov" then "variable a0 equal 4.016"
if "${pot} == mendelev" then "variable a0 equal 4.045"

units        metal
atom_style   atomic
boundary     p p p
lattice      fcc ${a0}
region       box block 0 ${nx} 0 ${nx} 0 ${nz}
create_box   1 box
create_atoms 1 box
mass         1 26.982
include      pot_${pot}.lmp
timestep     0.002
thermo_style custom step temp press pzz pe enthalpy lx ly lz
thermo       1000

# 1) solid at T0, zero stress
velocity     all create ${T0} ${seed} mom yes rot yes dist gaussian
fix          eq all npt temp ${T0} ${T0} 0.2 aniso 0.0 0.0 2.0
run          ${neq}
unfix        eq
write_data   solid_${pot}_${T0}.data

# 2) melt the upper half with the lower half frozen
variable     zmid equal (zlo+zhi)/2
region       up block INF INF INF INF ${zmid} INF units box
group        liq region up
group        sol subtract all liq
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
fix          melt liq nvt temp ${Tmelt} ${Tmelt} 0.2
run          ${neq}
unfix        melt
# 3) bring the liquid to T0 at fixed box (nvt thermostats the liq group itself;
#    fix npt would thermostat the temperature of ALL atoms, frozen solid included)
fix          cool liq nvt temp ${T0} ${T0} 0.2
run          ${neq}
unfix        cool
unfix        freeze
velocity     sol create ${T0} $(v_seed+1) mom yes rot yes dist gaussian
# relax z with all atoms at T0 (x-y stay at the solid lattice of step 1)
fix          relax all npt temp ${T0} ${T0} 0.2 z 0.0 0.0 2.0
run          $(v_neq/2)
unfix        relax

# 4) coexistence along z: ens = nph (T relaxes to T_m) or npt (interface moves unless T0 = T_m)
#    solid fraction by adaptive-free CNA (fcc), cutoff 0.854·a0
compute      cna all cna/atom $(0.854*v_a0)
variable     issol atom c_cna==1
compute      nsol all reduce sum v_issol
variable     fsol equal c_nsol/atoms
if "${ens} == npt" then "fix prod all npt temp ${T0} ${T0} 0.2 z 0.0 0.0 2.0" else "fix prod all nph z 0.0 0.0 2.0"
fix          avg all ave/time 100 10 1000 v_fsol
thermo_style custom step temp press pzz pe enthalpy lz v_fsol
dump         d all custom 25000 coexist_${ens}_${pot}_${T0}.dump id x y z c_cna
run          ${nprod}
write_data   coexist_${ens}_${pot}_${T0}.data
