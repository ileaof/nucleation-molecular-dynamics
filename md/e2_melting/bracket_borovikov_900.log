unfix        relax

# 4) coexistence along z: ens = nph (T relaxes to T_m) or npt (interface moves unless T0 = T_m)
#    solid fraction by adaptive-free CNA (fcc), cutoff 0.854·a0
compute      cna all cna/atom $(0.854*v_a0)
compute      cna all cna/atom 3.4296639999999998238
variable     issol atom c_cna==1
compute      nsol all reduce sum v_issol
variable     fsol equal c_nsol/atoms
if "${ens} == npt" then "fix prod all npt temp ${T0} ${T0} 0.2 z 0.0 0.0 2.0" else "fix prod all nph z 0.0 0.0 2.0"
fix prod all npt temp ${T0} ${T0} 0.2 z 0.0 0.0 2.0
fix prod all npt temp 900 ${T0} 0.2 z 0.0 0.0 2.0
fix prod all npt temp 900 900 0.2 z 0.0 0.0 2.0
fix          avg all ave/time 100 10 1000 v_fsol
thermo_style custom step temp press pzz pe enthalpy lz v_fsol
dump         d all custom 25000 coexist_${ens}_${pot}_${T0}.dump id x y z c_cna
dump         d all custom 25000 coexist_npt_${pot}_${T0}.dump id x y z c_cna
dump         d all custom 25000 coexist_npt_borovikov_${T0}.dump id x y z c_cna
dump         d all custom 25000 coexist_npt_borovikov_900.dump id x y z c_cna
run          ${nprod}
run          50000
