# 2) melt the upper half with the lower half frozen
variable     zmid equal (zlo+zhi)/2
region       up block INF INF INF INF ${zmid} INF units box
region       up block INF INF INF INF 48.5999999999998 INF units box
group        liq region up
1730 atoms in group liq
group        sol subtract all liq
1726 atoms in group sol
velocity     sol set 0 0 0
fix          freeze sol setforce 0 0 0
fix          melt liq nvt temp ${Tmelt} ${Tmelt} 0.2
fix          melt liq nvt temp 1700 ${Tmelt} 0.2
fix          melt liq nvt temp 1700 1700 0.2
run          ${neq}
run          5000
