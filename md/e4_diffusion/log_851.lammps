LAMMPS (10 Sep 2025)
  using 1 OpenMP thread(s) per MPI task
package gpu 1
# Self-diffusion of liquid Al (Borovikov 2024) from the mean-squared displacement, NPT at T, P = 0.
#   lmp -sf gpu -pk gpu 1 -in in.msd -var T 813
variable pot   index borovikov
variable T     index 813
variable n     index 12          # 6912 atoms
variable seed  index 11
variable nprod index 50000       # 100 ps
units        metal
atom_style   atomic
boundary     p p p
lattice      fcc 4.016
Lattice spacing in x,y,z = 4.016 4.016 4.016
region       box block 0 ${n} 0 ${n} 0 ${n}
region       box block 0 12 0 ${n} 0 ${n}
region       box block 0 12 0 12 0 ${n}
region       box block 0 12 0 12 0 12
create_box   1 box
Created orthogonal box = (0 0 0) to (48.192 48.192 48.192)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 6912 atoms
  using lattice units in orthogonal box = (0 0 0) to (48.192 48.192 48.192)
  create_atoms CPU = 0.000 seconds
mass         1 26.982
include      ../e2_melting/pot_${pot}.lmp
include      ../e2_melting/pot_borovikov.lmp
# Borovikov, Mendelev, Zarkevich, Smith, Lawson, Int. J. Plast. 178 (2024) 104004 — EAM/FS Ni-Al-Nb (NIST IPR)
pair_style eam/fs
pair_coeff * * ../../potentials/NiAlNb_Borovikov2024/Ni-Al-Nb.eam.fs Al
timestep     0.002
thermo       2500
velocity     all create 1500 ${seed} mom yes rot yes dist gaussian
velocity     all create 1500 11 mom yes rot yes dist gaussian
fix          m all npt temp 1500 1500 0.2 iso 0.0 0.0 2.0
run          5000

