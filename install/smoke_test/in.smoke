# Smoke test: same input on Windows and WSL LAMMPS (installation check only, not a physical choice)
# lmp -in in.smoke                    -> no PLUMED
# lmp -in in.smoke -var plumed 1      -> with fix plumed (WSL build only)
variable plumed index 0
units        metal
boundary     p p p
lattice      fcc 4.05
region       box block 0 5 0 5 0 5
create_box   1 box
create_atoms 1 box
mass         1 26.982
pair_style   eam/fs
pair_coeff   * * Al_mm.eam.fs Al
velocity     all create 600.0 4928459 mom yes rot yes dist gaussian
fix          1 all nve
compute      q6 all orientorder/atom degrees 1 6 nnn 12 cutoff 3.5
compute      q6m all reduce ave c_q6[1]
if "${plumed} == 1" then "fix pl all plumed plumedfile plumed.smoke.dat outfile plumed.smoke.log"
thermo_style custom step temp pe ke etotal press c_q6m
thermo_modify format float %20.12g
thermo       20
run          100
