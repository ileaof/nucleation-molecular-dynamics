# ten Wolde-type largest solid cluster (PLUMED 2.9 syntax; lengths in nm)
q6:   Q6 SPECIES=1-500 SWITCH={CUBIC D_0=0.30 D_MAX=0.35} LOWMEM
lq6:  LOCAL_Q6 SPECIES=q6 SWITCH={CUBIC D_0=0.30 D_MAX=0.35} LOWMEM
sol:  MFILTER_MORE DATA=lq6 SWITCH={CUBIC D_0=0.4 D_MAX=0.5}
cm:   CONTACT_MATRIX ATOMS=sol SWITCH={CUBIC D_0=0.30 D_MAX=0.35}
dfs:  DFSCLUSTERING MATRIX=cm
nat:  CLUSTER_NATOMS CLUSTERS=dfs CLUSTER=1
PRINT ARG=nat STRIDE=20 FILE=COLVAR.smoke
